# Copy to .env and fill in as needed. Never commit .env.

# --- TestPilot ---
# Which environment from config/environments.yaml to use.
TESTPILOT_ENV=local

# Override the system under test's URL without editing the config file.
# TESTPILOT_BASE_URL=http://127.0.0.1:8077

# chromium | firefox | webkit
# TESTPILOT_BROWSER=chromium

# off | on | retain-on-failure
# TESTPILOT_TRACE=retain-on-failure

# Set to "off" to force the deterministic rule-based AI provider.
# CI sets this so a missing key can never turn a build red.
# TESTPILOT_AI=off

# Enables live model analysis. Without it, the rule-based provider is used.
# ANTHROPIC_API_KEY=sk-ant-...

# --- ShopNest (system under test) ---
# none | coupon_stacking | stock_oversell | weak_auth | all
# SHOPNEST_FAULT_PROFILE=none

# Change this in any real deployment.
# SHOPNEST_JWT_SECRET=change-me
